generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STAFF
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  MONTHLY
  HALF_YEARLY
  ANNUAL
  PRACTICAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Class {
  id        String    @id @default(cuid())
  name      String
  section   String?
  year      Int
  students  Student[]
  results   Result[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, section, year])
}

model Student {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  guardianName  String
  guardianPhone String
  address       String?
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  results       Result[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Result {
  id            String   @id @default(cuid())
  studentId     String
  classId       String
  examType      ExamType
  subject       String
  marksObtained Float
  totalMarks    Float
  grade         String?
  examDate      DateTime
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
}
